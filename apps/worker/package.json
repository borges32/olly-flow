{
  "name": "@olly/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Worker de execuções do Olly Flow: consome a fila (BullMQ) e executa workflows com o motor",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@olly/api": "workspace:*",
    "@olly/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
