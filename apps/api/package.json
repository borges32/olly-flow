{
  "name": "@olly/api",
  "version": "0.0.0",
  "private": true,
  "description": "API REST do Olly Flow (NestJS + Fastify)",
  "type": "module",
  "exports": {
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "credentials": "node dist/cli/credentials.js",
    "users:admin": "node dist/cli/users-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@casl/ability": "^6.8.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/websockets": "^11.2.7",
    "@olly/db": "workspace:*",
    "@olly/engine": "workspace:*",
    "@olly/expressions": "workspace:*",
    "@olly/mcp-client": "workspace:*",
    "@olly/nodes": "workspace:*",
    "@olly/shared-types": "workspace:*",
    "@olly/task-runner": "workspace:*",
    "@olly/telemetry": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "bullmq": "^6.3.11",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "kysely": "^0.28.17",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@olly/mcp-test-server": "workspace:*",
    "@testcontainers/redis": "^11.14.0",
    "@types/node": "^22.20.5",
    "socket.io-client": "^4.8.1",
    "testcontainers": "^11.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
