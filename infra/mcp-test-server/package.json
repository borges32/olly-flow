{
  "name": "@olly/mcp-test-server",
  "version": "0.0.0",
  "private": true,
  "description": "Servidor MCP de teste e demonstração (spec 010, FR-013): Streamable HTTP e SSE, com autenticação opcional",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  }
}
