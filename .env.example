# Ambiente local de desenvolvimento. Copie para `.env` (cp .env.example .env).
# Todos os valores abaixo são fictícios e exclusivos do ambiente local (NFR-002).

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# PostgreSQL da plataforma
POSTGRES_USER=olly
POSTGRES_PASSWORD=olly
POSTGRES_DB=olly
DATABASE_URL=postgres://olly:olly@localhost:5432/olly

# Redis
REDIS_URL=redis://localhost:6379

# IdP de desenvolvimento (Keycloak). A API e o frontend usam apenas OIDC genérico.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8080/realms/olly
OIDC_CLIENT_ID=olly-web
OIDC_AUDIENCE=olly-api
# Endereço interno para descoberta/JWKS quando difere do emissor público (ex.: API em
# container no profile `app` do compose). Vazio: usa OIDC_ISSUER_URL.
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/olly
# Grupo do IdP que concede administração global (spec 002). Ajustar conforme a ADR-0005.
OIDC_ADMIN_GROUP=admin

# Expressões e execuções (spec 003)
OLLY_EXPRESSION_TIMEOUT_MS=100
OLLY_ISOLATE_MEMORY_MB=128
OLLY_NODE_DATA_MAX_BYTES=1048576
OLLY_TIMEZONE=America/Sao_Paulo
# Variáveis visíveis nas expressões como $env.NOME (prefixo removido). Nunca coloque segredos aqui.
# OLLY_EXPOSED_API_URL=https://exemplo.local

# Object storage (MinIO local, compatível com S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=olly
S3_SECRET_KEY=olly-dev-secret
S3_BUCKET=olly

# Frontend (expostas ao navegador pelo Vite; nunca coloque segredos em VITE_*)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/olly
VITE_OIDC_CLIENT_ID=olly-web
# Destino do proxy do Vite para /api e /health
API_URL=http://localhost:3000
