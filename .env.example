# Ambiente local de desenvolvimento. Copie para `.env` (cp .env.example .env).
# Todos os valores abaixo são fictícios e exclusivos do ambiente local (NFR-002).

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000

# PostgreSQL da plataforma
POSTGRES_USER=olly
POSTGRES_PASSWORD=olly
POSTGRES_DB=olly
DATABASE_URL=postgres://olly:olly@localhost:5432/olly

# Redis
REDIS_URL=redis://localhost:6379

# IdP de desenvolvimento (Keycloak). A API e o frontend usam apenas OIDC genérico.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OIDC_ISSUER_URL=http://localhost:8080/realms/olly
OIDC_CLIENT_ID=olly-web
OIDC_AUDIENCE=olly-api
# Endereço interno para descoberta/JWKS quando difere do emissor público (ex.: API em
# container no profile `app` do compose). Vazio: usa OIDC_ISSUER_URL.
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/olly
# Grupo do IdP que concede administração global (spec 002). Ajustar conforme a ADR-0005.
OIDC_ADMIN_GROUP=admin

# Expressões e execuções (spec 003)
OLLY_EXPRESSION_TIMEOUT_MS=100
OLLY_ISOLATE_MEMORY_MB=128
OLLY_NODE_DATA_MAX_BYTES=1048576
OLLY_TIMEZONE=America/Sao_Paulo
# Variáveis visíveis nas expressões como $env.NOME (prefixo removido). Nunca coloque segredos aqui.
# OLLY_EXPOSED_API_URL=https://exemplo.local

# Credenciais, HTTP e Postgres (spec 004)
# Chave mestra (KEK) das credenciais: base64 de 32 bytes. Valor fictício, só para desenvolvimento;
# em outros ambientes gere com `openssl rand -base64 32` (o provedor institucional vem com a ADR-0007).
OLLY_KEY_PROVIDER=env
OLLY_MASTER_KEY=I+JhPv8SrN+q61SgvfC7D4GFHERwEtAm+P8nFiweKo4=
# Hosts/CIDRs internos liberados para o nó HTTP (separados por vírgula). Padrão: nenhum.
OLLY_HTTP_ALLOWLIST=
OLLY_HTTP_MAX_RESPONSE_MB=50
OLLY_PG_POOL_MAX=5

# Webhooks, execuções e código JavaScript (spec 005)
OLLY_MAX_CONCURRENT_EXECUTIONS=10
# Corpo máximo do webhook (MB) e espera da resposta síncrona (s).
OLLY_WEBHOOK_MAX_BODY=16
OLLY_WEBHOOK_RESPONSE_TIMEOUT=120
OLLY_WEBHOOK_RATE_LIMIT_PER_MIN=120
# true: publicação recusa webhook de produção sem autenticação (padrão: só aviso).
OLLY_REQUIRE_WEBHOOK_AUTH=false
OLLY_CODE_TIMEOUT_MS=30000
OLLY_CODE_MEMORY_MB=128
# true só atrás de um proxy reverso confiável (usa X-Forwarded-For como IP do cliente).
OLLY_TRUST_PROXY=false

# Object storage (MinIO local, compatível com S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=olly
S3_SECRET_KEY=olly-dev-secret
S3_REGION=us-east-1
S3_BUCKET=olly

# Frontend (expostas ao navegador pelo Vite; nunca coloque segredos em VITE_*)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/olly
VITE_OIDC_CLIENT_ID=olly-web
# Destino do proxy do Vite para /api e /health
API_URL=http://localhost:3000

# Spec 006: fila, workers e paralelismo. Produção sempre pela fila (rode o worker:
# `pnpm --filter @olly/worker dev`); `OLLY_TEST_RUN_MODE=inprocess` executa os testes do
# editor no processo da API, sem worker. Tempos em segundos.
OLLY_TEST_RUN_MODE=queue
OLLY_WORKER_CONCURRENCY=20
OLLY_WORKER_SHUTDOWN_TIMEOUT=60
OLLY_WORKER_PORT=3101
OLLY_DEFAULT_WORKFLOW_TIMEOUT=300
OLLY_PROJECT_MAX_CONCURRENT=20
# Paralelismo padrão entre nós (o workflow pode definir settings.maxParallel); 1 = sequencial.
OLLY_DEFAULT_MAX_PARALLEL=8
