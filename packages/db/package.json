{
  "name": "@olly/db",
  "version": "0.0.0",
  "private": true,
  "description": "Kysely, tipos das tabelas, migrator (infra/migrations) e seed",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "migrate": "node dist/cli.js migrate",
    "rollback": "node dist/cli.js rollback",
    "seed": "node dist/cli.js seed"
  },
  "dependencies": {
    "@olly/shared-types": "workspace:*",
    "kysely": "^0.28.17",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
