{
  "name": "@olly/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Motor de execução: validação estrutural, estado da execução e execução sequencial",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
