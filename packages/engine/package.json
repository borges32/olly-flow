    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@olly/expressions": "workspace:*",
    "@olly/nodes": "workspace:*",
    "@olly/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
